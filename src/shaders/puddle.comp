#version 460
#extension GL_EXT_scalar_block_layout : require

// ============================================================================
// Rain puddle — PROXY-FREE compute pass (same architecture as fog/fire).
//
// No plane proxy / hit material. The water surface is intersected analytically:
// a horizontal plane at the region's center Y, bounded by the region's XZ box,
// with a procedural organic outline mask. The ripple normal comes from the same
// wave-equation field (rain_wave.comp). Shading matches the old
// standard_rt_puddle.rchit (Fresnel-Schlick at the water IOR blending a
// reflection against the wet ground) — but the reflection is SCREEN-SPACE
// (marched against the depth buffer, sampling the color buffer) since a compute
// pass cannot trace+shade real rays, and the refraction is the ground already in
// the color buffer (tinted). Composited into the HDR color before TAA; writes
// the sRGB display directly when TAA is off.
// ============================================================================

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform image2D color_image;     // HDR current color (history)
layout(set = 0, binding = 1, std140) uniform SceneUniforms
{
    mat4 view_inverse;
    mat4 projection_inverse;
    vec4 ambient_light;
    vec4 directional_light_color;
    vec4 directional_light_direction;
    vec4 directional_light_data;
    vec4 point_light_color;
    vec4 point_light_position;
    vec4 point_light_data;
    vec4 spot_light_color;
    vec4 spot_light_direction;
    vec4 spot_light_position;
    vec4 spot_light_data;
    vec4 grid_data;
    vec4 grid_origin_extent;
    vec4 skybox_data;
    uvec4 counts;
    uvec4 accumulation_data;
    vec4 animation_time_data;
    mat4 prev_view_projection;
    mat4 current_view_projection;   // used for SSR screen projection
} scene;
layout(set = 0, binding = 2, rg32f) uniform readonly image2D depth_image; // .x = hit distance (1e30 sky)
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D display_image;
layout(set = 0, binding = 4) uniform sampler2D wave_height;               // RG ripple field (R=height)
layout(set = 0, binding = 5) uniform sampler2D skybox_texture;            // environment (unused fallback)
// Planar reflection: the scene rendered from a mirror-flipped camera (sRGB).
// Sampled at the puddle's own screen position -> complete reflections, no cutoff.
layout(set = 0, binding = 6) uniform sampler2D reflection_texture;

layout(push_constant, std430) uniform PuddlePush
{
    vec4 center;       // xyz = region center (water plane at center.y), w = enabled
    vec4 half_size;    // xyz = region half-extent (XZ footprint), w = unused
    vec4 extent;       // x = width, y = height, z = write_display
} pud;

// ---- Look constants (match standard_rt_puddle.rchit) ------------------------
#define WATER_IOR           1.333
#define PUDDLE_REFLECTIVITY 0.8
#define PUDDLE_TINT         vec3(0.06, 0.10, 0.13)
#define PUDDLE_NORMAL_AMP   18.0
#define PUDDLE_SHAPE        1
#define PUDDLE_EDGE_SOFT    0.18

vec3 linear_to_srgb(vec3 c)
{
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(0.0031308, c));
}

// Environment colour in a direction — ported from standard_rt.rmiss evaluate_sky
// so the puddle reflects the same sky/skybox the scene shows. A CLEAN analytic
// sample (no screen marching), so it never smears/repeats.
const float kPI    = 3.14159265358979323846;
const float kTwoPI = 6.28318530717958647692;
vec3 evaluate_sky(vec3 dir)
{
    if (scene.skybox_data.x > 0.5)
    {
        vec3 d = normalize(dir);
        float u = atan(d.z, d.x) / kTwoPI + 0.5 + scene.skybox_data.y / kTwoPI;
        float v = acos(clamp(d.y, -1.0, 1.0)) / kPI;
        return texture(skybox_texture, vec2(fract(u), clamp(v, 0.0, 1.0))).rgb;
    }
    vec3 ambient = scene.ambient_light.rgb * max(scene.ambient_light.a, 0.35);
    vec3 horizon = max(vec3(0.10, 0.11, 0.13), ambient * 0.7 + vec3(0.05, 0.05, 0.06));
    vec3 zenith  = max(vec3(0.18, 0.22, 0.30), ambient * 1.3 + vec3(0.08, 0.10, 0.14));
    float tt = clamp(dir.y * 0.5 + 0.5, 0.0, 1.0);
    vec3 color = mix(horizon, zenith, smoothstep(0.0, 1.0, tt));
    if (scene.directional_light_color.a > 0.0)
    {
        vec3 sun = normalize(-scene.directional_light_direction.xyz);
        float s = pow(max(dot(dir, sun), 0.0), 256.0);
        color += scene.directional_light_color.rgb * scene.directional_light_color.a * s;
    }
    return color;
}

float puddle_hash11(float p) { return fract(sin(p * 127.1) * 43758.5453); }

// Organic puddle outline from the local UV (ported from the puddle .rchit),
// randomized per puddle by `seed`. ~1 inside, 0 outside.
float puddle_mask(vec2 uv, float seed)
{
#if PUDDLE_SHAPE
    vec2 q = uv * 2.0 - 1.0;
    float rot = seed * 6.2831853;
    float cs = cos(rot), sn = sin(rot);
    q = mat2(cs, -sn, sn, cs) * q;
    float d = length(q);
    float a = atan(q.y, q.x);
    float p1 = seed * 6.283;
    float p2 = puddle_hash11(seed + 1.0) * 6.283;
    float p3 = puddle_hash11(seed + 2.0) * 6.283;
    float f1 = 3.0  + floor(puddle_hash11(seed + 3.0) * 3.0);
    float f2 = 6.0  + floor(puddle_hash11(seed + 4.0) * 4.0);
    float f3 = 11.0 + floor(puddle_hash11(seed + 5.0) * 6.0);
    float wob = 0.10  * sin(a * f1 + p1)
              + 0.05  * sin(a * f2 + p2)
              + 0.035 * sin(a * f3 + p3);
    float radius = 0.90 + 0.06 * (puddle_hash11(seed + 6.0) - 0.5) * 2.0 + wob;
    return smoothstep(radius, radius - PUDDLE_EDGE_SOFT, d);
#else
    return 1.0;
#endif
}

vec3 srgb_to_linear(vec3 c)
{
    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(0.04045, c));
}

// Planar reflection lookup: the reflection_texture is the scene rendered from a
// camera mirror-flipped across the puddle plane, so the reflection at this water
// fragment is simply that render at the fragment's own screen UV. The ripple
// normal perturbs the lookup so the reflection shimmers with the wave field.
// Complete reflections of everything on the mirrored screen — no SSR cutoff.
vec3 planar_reflection(ivec2 ipos, ivec2 size, vec3 N)
{
    vec2 uv = (vec2(ipos) + 0.5) / vec2(size);
    uv += N.xz * 0.05;                 // ripple distortion
    uv = clamp(uv, vec2(0.0), vec2(1.0));
    return srgb_to_linear(textureLod(reflection_texture, uv, 0.0).rgb);
}

void main()
{
    if (pud.center.w <= 0.0)
    {
        return;
    }

    ivec2 ipos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(int(pud.extent.x), int(pud.extent.y));
    if (ipos.x >= size.x || ipos.y >= size.y)
    {
        return;
    }

    // Reconstruct the primary view ray (pixel center).
    vec2 ndc = ((vec2(ipos) + 0.5) / vec2(size)) * 2.0 - 1.0;
    vec4 view_target = scene.projection_inverse * vec4(ndc, 1.0, 1.0);
    vec3 view_dir = normalize(view_target.xyz / max(view_target.w, 0.0001));
    vec3 cam = (scene.view_inverse * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    vec3 rd = normalize((scene.view_inverse * vec4(view_dir, 0.0)).xyz);

    // Intersect the horizontal water plane y = center.y.
    float water_y = pud.center.y;
    if (abs(rd.y) < 1e-4) return;
    float t = (water_y - cam.y) / rd.y;
    if (t <= 0.0) return;

    vec3 hit = cam + rd * t;

    // Within the region XZ footprint?
    vec2 local = (hit.xz - pud.center.xz) / max(pud.half_size.xz, vec2(1e-3));
    if (abs(local.x) > 1.0 || abs(local.y) > 1.0) return;

    // Occluded by solid geometry in front of the water plane?
    float scene_dist = imageLoad(depth_image, ipos).x;
    if (scene_dist < 1e29 && t > scene_dist + 0.02) return;

    vec2 uv = local * 0.5 + 0.5;

    // Organic outline so the rectangular footprint reads as a puddle.
    float seed = fract(sin(dot(pud.center.xz, vec2(12.9898, 78.233)) + pud.center.y * 37.0) * 43758.5453);
    float mask = puddle_mask(uv, seed);
    if (mask <= 0.001) return;

    // Ripple normal from the wave height field gradient (horizontal plane frame:
    // tangent = +X, bitangent = +Z, base normal = +Y).
    vec2 texel = 1.0 / vec2(textureSize(wave_height, 0));
    float hL = texture(wave_height, uv - vec2(texel.x, 0.0)).x;
    float hR = texture(wave_height, uv + vec2(texel.x, 0.0)).x;
    float hD = texture(wave_height, uv - vec2(0.0, texel.y)).x;
    float hU = texture(wave_height, uv + vec2(0.0, texel.y)).x;
    vec3 N = normalize(vec3(-(hR - hL) * PUDDLE_NORMAL_AMP, 1.0, -(hU - hD) * PUDDLE_NORMAL_AMP));

    // Fresnel-Schlick at the water IOR.
    float F0 = (1.0 - WATER_IOR) / (1.0 + WATER_IOR);
    F0 *= F0;
    float cos_i = clamp(dot(N, -rd), 0.0, 1.0);
    float fresnel = F0 + (1.0 - F0) * pow(1.0 - cos_i, 5.0);

    // Existing color at this pixel = the wet ground (the refraction/see-through).
    vec3 ground = imageLoad(color_image, ipos).rgb;
    vec3 refracted = mix(PUDDLE_TINT, ground, 0.92);

    // Reflection: the clean sky/skybox in the reflected direction, with on-screen
    // geometry layered in via SSR where it genuinely hits. No screen-edge smear.
    // Reflection: sample the mirror-camera render at this fragment (complete,
    // no cutoff), rippled by the wave normal.
    vec3 reflected = planar_reflection(ipos, size, N);

    // Strong, mirror-like puddle: reflective even looking straight down, ramping
    // to near-full at grazing angles.
    float reflectivity = clamp(fresnel * 0.55 + 0.45, 0.0, 0.95);
    vec3 water = mix(refracted, reflected, reflectivity);
    water += PUDDLE_TINT * 0.10 * (1.0 - reflectivity);

    vec3 outl = mix(ground, water, mask);
    imageStore(color_image, ipos, vec4(outl, 1.0));

    if (pud.extent.z > 0.5) // TAA off
    {
        imageStore(display_image, ipos, vec4(linear_to_srgb(max(outl, 0.0)), 1.0));
    }
}
