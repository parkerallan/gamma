#version 460

// Temporal Anti-Aliasing resolve compute pass.
//
// Algorithm overview:
//   1. Fetch this frame's linear-HDR sample written by the rgen.
//   2. Compute the 3x3 neighborhood AABB in tonemapped-luminance space; pick
//      the closest-depth neighbor as the canonical motion sample so thin
//      features keep their MVs intact.
//   3. Sample the previous frame's resolved history at `pixel_uv - mv` with
//      a 4-tap Catmull-Rom kernel for sharpness.
//   4. Clip the history sample to the neighborhood AABB to suppress ghosting.
//   5. Compute an anti-flicker weight from the relative tonemapped luminance
//      between current and clipped history.
//   6. Blend: out = mix(history, current, source_weight). On first frame
//      after a reset (history_valid == 0) we just emit current.
//   7. Encode linear -> sRGB into the user-visible output.
//
// The ping-pong is performed on the host side via descriptor rebind: every
// frame `history` and `resolve_output` are bound to alternating
// taa_resolve_image[0/1] slots.

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D current_radiance;
layout(set = 0, binding = 1) uniform sampler2D history;
layout(set = 0, binding = 2) uniform sampler2D motion_vectors;
layout(set = 0, binding = 3) uniform sampler2D linear_depth;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D resolve_output;
layout(set = 0, binding = 5, rgba8) uniform writeonly image2D tonemapped_output;

layout(set = 0, binding = 6, std140) uniform TaaSettings
{
    vec4 viewport_and_flags; // x=w, y=h, z=enabled, w=debug_mode
    vec4 params;             // x=source_weight, y=max_frames, z=jitter_enabled, w=reconstruct_enabled
    vec4 state;              // x=history_valid, yzw reserved
} taa;

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

float linear_to_srgb_channel(float value)
{
    value = max(value, 0.0);
    if (value <= 0.0031308)
    {
        return value * 12.92;
    }
    return 1.055 * pow(value, 1.0 / 2.4) - 0.055;
}

vec3 linear_to_srgb(vec3 value)
{
    return clamp(
        vec3(
            linear_to_srgb_channel(value.r),
            linear_to_srgb_channel(value.g),
            linear_to_srgb_channel(value.b)),
        vec3(0.0),
        vec3(1.0));
}

float luma(vec3 c)
{
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// Reinhard on luminance only — used as the perceptual space for AABB clipping
// and anti-flicker weighting. Inverse maps cleanly back to linear HDR.
vec3 tonemap(vec3 c)
{
    float L = luma(c);
    return c / (1.0 + L);
}

vec3 inverse_tonemap(vec3 c)
{
    float L = luma(c);
    return c / max(1.0 - L, 1.0e-4);
}

// Bicubic Catmull-Rom history sampling. Reads 9 bilinear taps weighted to
// produce a sharper history filter than a single bilinear sample.
vec3 sample_history_catmull_rom(sampler2D tex, vec2 uv, vec2 inv_size)
{
    vec2 tex_size = 1.0 / inv_size;
    vec2 sample_pos = uv * tex_size;
    vec2 tex_pos1 = floor(sample_pos - 0.5) + 0.5;
    vec2 f = sample_pos - tex_pos1;

    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);

    vec2 w12 = w1 + w2;
    vec2 offset12 = w2 / (w12 + vec2(1.0e-6));

    vec2 tex_pos0  = tex_pos1 - 1.0;
    vec2 tex_pos3  = tex_pos1 + 2.0;
    vec2 tex_pos12 = tex_pos1 + offset12;

    tex_pos0  *= inv_size;
    tex_pos3  *= inv_size;
    tex_pos12 *= inv_size;

    vec3 result = vec3(0.0);
    result += textureLod(tex, vec2(tex_pos0.x,  tex_pos0.y),  0.0).rgb * (w0.x  * w0.y);
    result += textureLod(tex, vec2(tex_pos12.x, tex_pos0.y),  0.0).rgb * (w12.x * w0.y);
    result += textureLod(tex, vec2(tex_pos3.x,  tex_pos0.y),  0.0).rgb * (w3.x  * w0.y);

    result += textureLod(tex, vec2(tex_pos0.x,  tex_pos12.y), 0.0).rgb * (w0.x  * w12.y);
    result += textureLod(tex, vec2(tex_pos12.x, tex_pos12.y), 0.0).rgb * (w12.x * w12.y);
    result += textureLod(tex, vec2(tex_pos3.x,  tex_pos12.y), 0.0).rgb * (w3.x  * w12.y);

    result += textureLod(tex, vec2(tex_pos0.x,  tex_pos3.y),  0.0).rgb * (w0.x  * w3.y);
    result += textureLod(tex, vec2(tex_pos12.x, tex_pos3.y),  0.0).rgb * (w12.x * w3.y);
    result += textureLod(tex, vec2(tex_pos3.x,  tex_pos3.y),  0.0).rgb * (w3.x  * w3.y);

    return max(result, vec3(0.0));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 viewport = ivec2(taa.viewport_and_flags.xy);
    if (pixel.x >= viewport.x || pixel.y >= viewport.y)
    {
        return;
    }

    vec2 inv_size = 1.0 / vec2(viewport);
    vec2 pixel_uv = (vec2(pixel) + vec2(0.5)) * inv_size;

    vec3 current_linear = imageLoad(current_radiance, pixel).rgb;

    bool taa_enabled   = taa.viewport_and_flags.z > 0.5;
    bool history_valid = taa.state.x > 0.5;

    // 1) Per-pixel motion vector.
    //
    // Rasterizer TAA implementations typically dilate the MV across a 3x3
    // neighborhood, picking the *closest-depth* neighbor's MV. That trick
    // exists to fix thin features dropped by undersampled rasterization.
    // It is actively HARMFUL with ray-traced primaries: along an
    // A-in-front-of-B silhouette, every pixel on B that has any A-neighbor
    // in its 3x3 window would inherit A's MV, then sample history at
    // "where A was" -> reads A's old color -> blends A's color onto B's
    // silhouette as a fading trail during view rotation.  And on edges
    // the dilation winner can flip frame-to-frame with jitter, oscillating
    // the MV between two surfaces and visibly wiggling edge colors.
    //
    // The rgen's per-pixel MV is computed from the actual jittered ray's
    // world hit, so it already corresponds to whatever surface this pixel
    // sees -- no dilation needed.
    vec2 best_mv = texelFetch(motion_vectors, pixel, 0).xy;

    // 2) Neighborhood statistics in tonemapped space.
    //    We collect both the absolute min/max AABB (loose, conservative
    //    bound) and the first/second moments of the 3x3 neighborhood so we
    //    can build a tight variance-based clip box (Salvi 2016 /
    //    "High-Quality Temporal Supersampling").  The variance box is much
    //    better at rejecting foreign-object history during disocclusion
    //    than min/max alone, which is what produces the colored trail of
    //    one model smearing over another during viewport rotation.
    vec3 neigh_min = vec3( 1.0e30);
    vec3 neigh_max = vec3(-1.0e30);
    vec3 neigh_sum = vec3(0.0);
    vec3 neigh_sum_sq = vec3(0.0);
    for (int dy = -1; dy <= 1; ++dy)
    {
        for (int dx = -1; dx <= 1; ++dx)
        {
            ivec2 q = clamp(pixel + ivec2(dx, dy), ivec2(0), viewport - 1);
            vec3 s = tonemap(imageLoad(current_radiance, q).rgb);
            neigh_min = min(neigh_min, s);
            neigh_max = max(neigh_max, s);
            neigh_sum += s;
            neigh_sum_sq += s * s;
        }
    }
    const float inv_count = 1.0 / 9.0;
    vec3 neigh_mean = neigh_sum * inv_count;
    vec3 neigh_var  = max(neigh_sum_sq * inv_count - neigh_mean * neigh_mean, vec3(0.0));
    vec3 neigh_sigma = sqrt(neigh_var);

    // gamma controls clip-box width in standard deviations.  ~1.25 is a
    // good balance: tight enough to catch disocclusion, wide enough to
    // accept a slowly-drifting jittered edge as "still the same surface".
    const float clip_gamma = 1.25;
    vec3 var_min = neigh_mean - clip_gamma * neigh_sigma;
    vec3 var_max = neigh_mean + clip_gamma * neigh_sigma;
    // Intersect with the absolute AABB so we never produce a clip box
    // outside the actually-observed sample range.
    vec3 clip_min = max(var_min, neigh_min);
    vec3 clip_max = min(var_max, neigh_max);

    vec3 resolved_linear = current_linear;

    if (taa_enabled && history_valid)
    {
        vec2 history_uv = pixel_uv - best_mv;
        // Off-screen reprojection -> no temporal information; keep current.
        if (history_uv.x >= 0.0 && history_uv.x <= 1.0 &&
            history_uv.y >= 0.0 && history_uv.y <= 1.0)
        {
            vec3 history_linear = sample_history_catmull_rom(history, history_uv, inv_size);

            // 4) Motion-magnitude-aware clip + disocclusion rejection.
            //
            // Two distinct TAA failure modes have to be balanced here:
            //
            //  (a) STATIC viewport, edges still jitter:  every frame the
            //      3x3 neighborhood is built from a single jittered sample
            //      per pixel, so the AABB / variance box around an
            //      edge changes shape every frame.  If we clip the
            //      converged history to that wiggling box, the displayed
            //      edge color wiggles with the box even when nothing
            //      actually moved.  Solution: at zero motion don't clip
            //      at all -- the converged history is already correct.
            //
            //  (b) ROTATING viewport, trail of one model over another:
            //      during view rotation a pixel reprojects to where some
            //      OTHER surface was last frame, and the bicubic returns
            //      that surface's color.  The clip and a disocclusion
            //      boost on source_weight need to be fully active here
            //      to drop the foreign history.
            //
            // We blend the clip strength linearly with motion in pixels:
            // 0 px -> no clip ("trust the converged history"), >=1.5 px
            // -> full clip ("reject anything outside current neighborhood").
            float mv_pixels = length(best_mv * vec2(viewport));
            float clip_blend = clamp(mv_pixels * (1.0 / 1.5), 0.0, 1.0);

            vec3 history_tm = tonemap(history_linear);
            vec3 history_tm_clamped = clamp(history_tm, clip_min, clip_max);
            // Distance from the unclipped history to the clip box -- non
            // zero only when history actually fell outside.  We multiply
            // by clip_blend so static pixels never trigger a spurious
            // disocclusion just because their wiggling box drifted past
            // a converged value.
            float clip_dist = length(history_tm_clamped - history_tm) * clip_blend;
            history_tm = mix(history_tm, history_tm_clamped, clip_blend);
            history_linear = inverse_tonemap(history_tm);

            // 5) Blend.  Base contribution is the configured weight
            //    (~1/16).  When we detect a real disocclusion (history
            //    fell well outside the clip box AND there is motion) we
            //    drive source_weight toward 1.0 to discard the foreign
            //    history color entirely.  The scale is intentionally
            //    aggressive (8x): the user-visible artifact is a slow
            //    fading colored smear across multiple frames, so a soft
            //    rejection leaves a residual trail; we want it gone in
            //    one or two frames.
            const float disocclusion_scale = 8.0;
            float disocclusion = clamp(clip_dist * disocclusion_scale, 0.0, 1.0);

            float min_weight = 1.0 / max(taa.params.y, 1.0);
            float base_weight = clamp(taa.params.x, min_weight, 1.0);
            float source_weight = mix(base_weight, 1.0, disocclusion);

            resolved_linear = mix(history_linear, current_linear, source_weight);
        }
    }

    imageStore(resolve_output, pixel, vec4(resolved_linear, 1.0));
    imageStore(tonemapped_output, pixel, vec4(linear_to_srgb(resolved_linear), 1.0));
}
