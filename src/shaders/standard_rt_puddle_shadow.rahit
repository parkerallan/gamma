#version 460
#extension GL_EXT_ray_tracing : require

// Puddle shadow any-hit: the water surface is a transparent reflective/
// refractive material, so it must not occlude shadow rays. Ignoring every
// intersection lets shadow rays pass through the plane proxy to the real
// occluder (or the shadow miss = fully lit), so the puddle casts no shadow.

void main()
{
    ignoreIntersectionEXT;
}
