#version 460
#extension GL_EXT_ray_tracing : require

struct PrimaryPayload
{
    vec4 color;
    float hit_distance;
    uint depth;
    // World-space position of the hit point as it was in the PREVIOUS frame.
    // For static instances this equals the current frame's world hit; for
    // rigid-body-moving instances the rchit computes
    //   prev_world_pos = prev_O2W * (gl_WorldToObjectEXT * world_hit)
    // so projecting through view_proj_prev produces a motion vector that
    // includes the object's world-space motion, not just camera motion.
    vec3 prev_world_pos;
};

layout(set = 0, binding = 0) uniform accelerationStructureEXT top_level_as;
layout(set = 0, binding = 1, rgba8) uniform image2D output_image;
layout(set = 0, binding = 7, rgba16f) uniform image2D history_image;
layout(set = 0, binding = 9, rg16f) uniform image2D motion_vector_image;
layout(set = 0, binding = 10, r32f) uniform image2D linear_depth_image;

layout(set = 0, binding = 2, std140) uniform SceneUniforms
{
    mat4 view_inverse;
    mat4 projection_inverse;
    vec4 ambient_light;
    vec4 directional_light_color;
    vec4 directional_light_direction;
    vec4 directional_light_data;
    vec4 point_light_color;
    vec4 point_light_position;
    vec4 point_light_data;
    vec4 spot_light_color;
    vec4 spot_light_direction;
    vec4 spot_light_position;
    vec4 spot_light_data;
    vec4 grid_data;
    vec4 grid_origin_extent;
    vec4 skybox_data;
    uvec4 counts;
    uvec4 accumulation_data;
    mat4 view_proj_curr;
    mat4 view_proj_prev;
    vec4 jitter_state;
} scene_uniforms;

layout(location = 0) rayPayloadEXT PrimaryPayload primary_payload;

uint pcg_hash(uint value)
{
    uint state = value * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float hash_to_unit_float(uint value)
{
    return float(pcg_hash(value)) * (1.0 / 4294967296.0);
}

// Halton(base) low-discrepancy sequence in [0, 1). The (2, 3) pair gives a
// well-distributed sub-pixel jitter pattern that resolves cleanly under temporal
// accumulation. We wrap the sequence index every 64 samples to avoid the long
// "tail" of Halton becoming visible as periodic clusters.
float halton(uint index, uint base)
{
    float result = 0.0;
    float fraction = 1.0;
    while (index > 0u)
    {
        fraction /= float(base);
        result += fraction * float(index % base);
        index /= base;
    }
    return result;
}

// Sub-pixel jitter centered on (0, 0) and bounded to ±0.5 px. Indexed by the
// raw frame counter (accumulation_data.w) so the sequence advances every frame
// even after temporal accumulation has saturated. The pixel coordinate is NOT
// mixed in: every pixel must share the same sub-pixel offset for the camera
// ray jitter to act as supersampling rather than per-pixel noise.
vec2 jittered_sample_offset(uint frame_index)
{
    uint cycle_index = (frame_index % 64u) + 1u; // Halton is undefined at 0
    return vec2(halton(cycle_index, 2u), halton(cycle_index, 3u)) - vec2(0.5);
}

float linear_to_srgb_channel(float value)
{
    value = max(value, 0.0);
    if (value <= 0.0031308)
    {
        return value * 12.92;
    }

    return 1.055 * pow(value, 1.0 / 2.4) - 0.055;
}

vec3 linear_to_srgb(vec3 value)
{
    return clamp(
        vec3(
            linear_to_srgb_channel(value.r),
            linear_to_srgb_channel(value.g),
            linear_to_srgb_channel(value.b)),
        vec3(0.0),
        vec3(1.0));
}

vec3 evaluate_point_light_emitter(vec3 ray_origin, vec3 ray_direction, float scene_hit_distance)
{
    if (scene_uniforms.point_light_color.a <= 0.0)
    {
        return vec3(0.0);
    }

    vec3 light_center = scene_uniforms.point_light_position.xyz;
    float source_radius = max(scene_uniforms.point_light_data.x, 0.02);
    float halo_intensity = max(scene_uniforms.point_light_data.y, 0.0);
    float halo_radius    = max(scene_uniforms.point_light_data.z, 0.01);
    float light_range = max(scene_uniforms.point_light_position.w, 0.001);
    vec3 base_color = max(scene_uniforms.point_light_color.rgb, vec3(0.0));
    float intensity = max(scene_uniforms.point_light_color.a, 0.0);

    vec3 center_delta = light_center - ray_origin;
    float closest_t = dot(center_delta, ray_direction);
    vec3 closest_point = ray_origin + ray_direction * max(closest_t, 0.0);
    float radial_distance = length(light_center - closest_point);

    vec3 result = vec3(0.0);

    // Smooth volumetric halo computed in angular space so apparent glow
    // remains constant regardless of how far the camera is from the light.
    if (closest_t > 0.0 && closest_t < scene_hit_distance)
    {
        // Angular radial: angle in radians from ray axis to light center.
        float inv_dist = 1.0 / max(closest_t, 0.001);
        float angular_radial  = radial_distance * inv_dist;
        float angular_source  = source_radius   * inv_dist;

        // Perspective-responsive halo spread: apparent size shrinks as
        // camera distance increases, while halo_intensity controls glow energy.
        float halo_sigma_outer_ang = max(angular_source * 4.2 * halo_radius, 0.00015);
        float halo_sigma_inner_ang = max(angular_source * 1.6 * halo_radius, 0.00008);

        float halo_outer = exp(-(angular_radial * angular_radial) / max(halo_sigma_outer_ang * halo_sigma_outer_ang, 1e-6));
        float halo_inner = exp(-(angular_radial * angular_radial) / max(halo_sigma_inner_ang * halo_sigma_inner_ang, 1e-6));

        // Keep emitter halo stable with camera zoom: no camera-distance fade.
        float halo_hotness = clamp(halo_inner * 0.75 + halo_outer * 0.25, 0.0, 1.0);
        vec3 halo_color = mix(base_color * 0.55, vec3(1.0, 0.985, 0.955), halo_hotness * 0.55);
        float halo_energy = (halo_outer * 0.55 + halo_inner * 0.45);
        result += halo_color * intensity * halo_intensity * halo_energy * 1.1;
    }

    // Analytic emitter sphere intersection so the source exists in real 3D space.
    vec3 oc = ray_origin - light_center;
    float b = dot(oc, ray_direction);
    float c = dot(oc, oc) - source_radius * source_radius;
    float h = b * b - c;
    if (h >= 0.0)
    {
        float s = sqrt(h);
        float t_near = -b - s;
        float t_far = -b + s;
        float hit_t = t_near > 0.0 ? t_near : (t_far > 0.0 ? t_far : -1.0);
        if (hit_t > 0.0 && hit_t < scene_hit_distance)
        {
            vec3 hit_position = ray_origin + ray_direction * hit_t;
            vec3 sphere_normal = normalize(hit_position - light_center);
            float facing = clamp(dot(-ray_direction, sphere_normal), 0.0, 1.0);
            float radial_unit = clamp(radial_distance / max(source_radius, 1e-6), 0.0, 1.0);
            float radial_center = 1.0 - radial_unit;

            // Broad center lobe plus a smaller hot core to avoid a tiny white pin-dot.
            float body_weight = pow(radial_center, 1.8);
            float core_weight = pow(radial_center, 3.2);
            float limb = 0.5 + 0.5 * facing;

            float whiten = clamp(body_weight * 0.55 + core_weight * 0.45, 0.0, 1.0);
            vec3 warm_white = vec3(1.0, 0.992, 0.97);
            vec3 radial_color = mix(base_color, warm_white, whiten);

            float brightness = (1.2 + 4.5 * body_weight + 7.5 * core_weight) * limb;
            result += radial_color * intensity * brightness;
        }
    }

    return result;
}

vec3 trace_primary_sample(vec2 pixel_sample, vec2 launch_size, out vec3 world_origin_out, out vec3 world_direction_out)
{
    vec2 ndc = (pixel_sample / launch_size) * 2.0 - 1.0;

    vec4 clip_target = vec4(ndc.x, ndc.y, 1.0, 1.0);
    vec4 view_target = scene_uniforms.projection_inverse * clip_target;
    vec3 view_direction = normalize(view_target.xyz / max(view_target.w, 0.0001));
    vec3 world_origin = (scene_uniforms.view_inverse * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    vec3 world_direction = normalize((scene_uniforms.view_inverse * vec4(view_direction, 0.0)).xyz);
    world_origin_out = world_origin;
    world_direction_out = world_direction;

    primary_payload.color = vec4(0.08, 0.09, 0.11, 1.0);
    primary_payload.hit_distance = 1e30;
    primary_payload.depth = 0;
    traceRayEXT(
        top_level_as,
        gl_RayFlagsNoneEXT,
        0xFF,
        0,
        1,
        0,
        world_origin,
        0.001,
        world_direction,
        10000.0,
        0);

    vec3 shaded = primary_payload.color.rgb;
    shaded += evaluate_point_light_emitter(world_origin, world_direction, primary_payload.hit_distance);
    return shaded;
}

void main()
{
    vec2 launch_size = vec2(gl_LaunchSizeEXT.xy);
    vec2 pixel_center = vec2(gl_LaunchIDEXT.xy) + vec2(0.5);

    // Halton(2,3) sub-pixel jitter for super-sampling under temporal
    // accumulation. The host upload sets scene_uniforms.jitter_state.xy in
    // pixel units; when TAA jitter is disabled the host writes zeros.
    vec2 jitter_curr = scene_uniforms.jitter_state.xy;
    vec2 jitter_prev = scene_uniforms.jitter_state.zw;
    vec2 pixel_jittered = pixel_center + jitter_curr;

    vec3 world_origin;
    vec3 world_direction;
    vec3 current_color = trace_primary_sample(pixel_jittered, launch_size, world_origin, world_direction);

    // Per-pixel motion vector in normalized [0,1] UV space.
    //   curr_uv = pixel_center / launch_size           (unjittered current pixel UV)
    //   prev_uv = projection of the same world point through the previous
    //             frame's view*projection, with previous frame's jitter
    //             un-applied so it matches that frame's UN-JITTERED pixel grid.
    // We store (curr_uv - prev_uv); the TAA resolve samples history at
    //   history_uv = curr_uv - mv.
    vec2 curr_uv = pixel_center / launch_size;
    vec2 mv = vec2(0.0);

    bool hit_geometry = primary_payload.hit_distance < 1.0e29;
    vec4 prev_clip;
    if (hit_geometry)
    {
        // Use the previous-frame world position written by the rchit /
        // grid-rmiss path. For a static instance this equals the current
        // world hit (MV reflects camera motion only); for a rigid body
        // that moved last frame -> this frame, the prev_world_pos lands
        // where that object-space point was last frame, so the resulting
        // MV includes the object's world-space motion.
        prev_clip = scene_uniforms.view_proj_prev * vec4(primary_payload.prev_world_pos, 1.0);
    }
    else
    {
        // Sky / miss: project the ray direction with w=0 so the result
        // reflects only camera rotation (camera translation has no parallax
        // effect at infinity). For a standard pinhole projection
        //   prev_clip = P_prev * V_prev * vec4(dir, 0)
        // the w component is -view_z, so dividing by w gives the correct
        // pinhole-projected NDC.x/y of the direction in the previous frame.
        prev_clip = scene_uniforms.view_proj_prev * vec4(world_direction, 0.0);
    }

    if (abs(prev_clip.w) > 1.0e-6)
    {
        vec3 prev_ndc = prev_clip.xyz / prev_clip.w;
        vec2 prev_uv = prev_ndc.xy * 0.5 + 0.5;
        // Cancel the CURRENT jitter, not the previous one. The world hit P
        // came from a ray jittered by jitter_curr, so prev_view_proj * P
        // lands at a position offset by ~jitter_curr/size from where the
        // unjittered current ray would have hit. Subtracting jitter_curr/size
        // recovers the prev-frame UN-jittered pixel-grid location of the
        // SAME world point. (history image stores values at integer pixel
        // centers, so we want the unjittered grid for sampling.) For a
        // static camera this yields MV = 0 exactly.
        prev_uv -= jitter_curr / launch_size;
        mv = curr_uv - prev_uv;
    }

    ivec2 pixel_xy = ivec2(gl_LaunchIDEXT.xy);
    imageStore(history_image, pixel_xy, vec4(current_color, 1.0));
    imageStore(motion_vector_image, pixel_xy, vec4(mv, 0.0, 0.0));
    imageStore(linear_depth_image, pixel_xy, vec4(primary_payload.hit_distance, 0.0, 0.0, 0.0));
}
