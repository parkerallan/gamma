#version 460
#extension GL_EXT_ray_tracing : require

struct PrimaryPayload
{
    vec4 color;
    float hit_distance;
    uint depth;
    vec3 pos_ws_curr;
    vec3 pos_ws_prev;
    vec3 shading_normal;
    uint material_flags; // bit 0 = supersample-this-pixel (set by rchit from material.supersample)
};

layout(set = 0, binding = 0) uniform accelerationStructureEXT top_level_as;
layout(set = 0, binding = 1, rgba8) uniform image2D output_image;
layout(set = 0, binding = 7, rgba16f) uniform image2D history_image;
layout(set = 0, binding = 9, rg16f) uniform image2D motion_image;
// Linear-depth G-buffer for this frame. The TAA pass reads this (curr) and
// the previous frame's slot to do per-tap bilateral disocclusion.
//   .x = this frame's primary-hit distance from the CURRENT camera. Becomes
//        next frame's "previous depth" via the ping-pong.
//   .y = EXPECTED previous-frame depth: distance from the PREVIOUS camera
//        position to the hit point's previous-frame world position
//        (pos_ws_prev). This is what last frame's rgen would have written at
//        the reprojected pixel if the same surface was visible there, so the
//        TAA disocclusion test can compare it against the stored previous
//        depth like-for-like. Comparing .x of two frames directly is NOT
//        valid under camera translation (a follow camera changes the
//        distance to every static surface each frame, which false-fired the
//        disocclusion test and injected raw 1-spp noise as a directional
//        shimmer while the player moved).
layout(set = 0, binding = 11, rg32f) uniform image2D depth_image;

layout(set = 0, binding = 2, std140) uniform SceneUniforms
{
    mat4 view_inverse;
    mat4 projection_inverse;
    vec4 ambient_light;
    vec4 directional_light_color;
    vec4 directional_light_direction;
    vec4 directional_light_data;
    vec4 point_light_color;
    vec4 point_light_position;
    vec4 point_light_data;
    vec4 spot_light_color;
    vec4 spot_light_direction;
    vec4 spot_light_position;
    vec4 spot_light_data;
    vec4 grid_data;
    vec4 grid_origin_extent;
    vec4 skybox_data;
    uvec4 counts;
    uvec4 accumulation_data;
    vec4 animation_time_data;
    mat4 prev_view_projection;
    mat4 current_view_projection;
    vec4 taa_params;       // .x = enabled, .y = variance, .z = anti_sparkle, .w = jitter_compensation
    vec4 jitter_offset;    // .xy = current sub-pixel jitter (px), .zw = previous
    vec4 adaptive_params;  // .x = enabled (0/1), .y = max_samples, .z = contrast_threshold, .w = reserved
    vec4 underwater_data;  // .x = has water, .y = base water height
    mat4 underwater_world_to_local;
    uvec4 cloud_count;       // .x = number of active clouds
    vec4 cloud_params[8];    // xyz=center, w=radius per cloud
    vec4 prev_camera_position; // .xyz = previous frame's camera world position (TAA depth disocclusion)
} scene_uniforms;

layout(location = 0) rayPayloadEXT PrimaryPayload primary_payload;
// Shadow ray payload (location 1) used by the volumetric spotlight march to
// test whether the light actually reaches each sample. Mirrors the shadow
// trace setup in standard_rt.rchit: payload starts at 1.0 (visible), the shadow
// miss shader leaves it, a hit drives it to 0.0 (occluded).
layout(location = 1) rayPayloadEXT float shadow_payload;

uint pcg_hash(uint value)
{
    uint state = value * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float hash_to_unit_float(uint value)
{
    return float(pcg_hash(value)) * (1.0 / 4294967296.0);
}

const int WATER_ITER_FRAGMENT = 5;
const mat2 WATER_OCTAVE_M = mat2(vec2(1.6, 1.2), vec2(-1.2, 1.6));
const float WATER_PLANE_HALF_EXTENT = 1.0005;

float water_hash12(vec2 p)
{
    uvec2 q = uvec2(ivec2(p)) * uvec2(1597334677u, 3812015801u);
    uint n = (q.x ^ q.y) * 1597334677u;
    return float(n) * (1.0 / 4294967295.0);
}

float water_noise(vec2 p)
{
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return -1.0 + 2.0 * mix(
        mix(water_hash12(i + vec2(0.0, 0.0)), water_hash12(i + vec2(1.0, 0.0)), u.x),
        mix(water_hash12(i + vec2(0.0, 1.0)), water_hash12(i + vec2(1.0, 1.0)), u.x),
        u.y);
}

float water_sea_octave(vec2 uv, float choppy)
{
    uv += water_noise(uv);
    vec2 wv = 1.0 - abs(sin(uv));
    vec2 swv = abs(cos(uv));
    wv = mix(wv, swv, wv);
    return pow(1.0 - pow(wv.x * wv.y, 0.65), choppy);
}

float water_wave_height(vec2 xz, float time_seconds)
{
    float freq = 0.18;
    float amp = 0.55;
    float choppy = 4.0;
    float speed = 0.85;
    vec2 uv = xz;
    uv.x *= 0.75;
    float h = 0.0;
    for (int i = 0; i < WATER_ITER_FRAGMENT; ++i)
    {
        float d = water_sea_octave((uv + time_seconds * speed) * freq, choppy);
        d += water_sea_octave((uv - time_seconds * speed) * freq, choppy);
        h += d * amp;
        uv *= WATER_OCTAVE_M;
        freq *= 1.9;
        amp *= 0.22;
        choppy = mix(choppy, 1.0, 0.2);
    }
    return h;
}

// Halton(base) low-discrepancy sequence in [0, 1). The (2, 3) pair gives a
// well-distributed sub-pixel jitter pattern that resolves cleanly under temporal
// accumulation. We wrap the sequence index every 64 samples to avoid the long
// "tail" of Halton becoming visible as periodic clusters.
float halton(uint index, uint base)
{
    float result = 0.0;
    float fraction = 1.0;
    while (index > 0u)
    {
        fraction /= float(base);
        result += fraction * float(index % base);
        index /= base;
    }
    return result;
}

// Sub-pixel jitter centered on (0, 0) and bounded to ±0.5 px. Indexed by the
// raw frame counter (accumulation_data.w) so the sequence advances every frame
// even after temporal accumulation has saturated. The pixel coordinate is NOT
// mixed in: every pixel must share the same sub-pixel offset for the camera
// ray jitter to act as supersampling rather than per-pixel noise.
vec2 jittered_sample_offset(uint frame_index)
{
    uint cycle_index = (frame_index % 64u) + 1u; // Halton is undefined at 0
    return vec2(halton(cycle_index, 2u), halton(cycle_index, 3u)) - vec2(0.5);
}

float linear_to_srgb_channel(float value)
{
    value = max(value, 0.0);
    if (value <= 0.0031308)
    {
        return value * 12.92;
    }

    return 1.055 * pow(value, 1.0 / 2.4) - 0.055;
}

vec3 linear_to_srgb(vec3 value)
{
    return clamp(
        vec3(
            linear_to_srgb_channel(value.r),
            linear_to_srgb_channel(value.g),
            linear_to_srgb_channel(value.b)),
        vec3(0.0),
        vec3(1.0));
}

vec3 evaluate_point_light_emitter(vec3 ray_origin, vec3 ray_direction, float scene_hit_distance)
{
    if (scene_uniforms.point_light_color.a <= 0.0)
    {
        return vec3(0.0);
    }

    vec3 light_center = scene_uniforms.point_light_position.xyz;
    float source_radius = max(scene_uniforms.point_light_data.x, 0.02);
    float halo_intensity = max(scene_uniforms.point_light_data.y, 0.0);
    float halo_radius    = max(scene_uniforms.point_light_data.z, 0.01);
    float light_range = max(scene_uniforms.point_light_position.w, 0.001);
    vec3 base_color = max(scene_uniforms.point_light_color.rgb, vec3(0.0));
    float intensity = max(scene_uniforms.point_light_color.a, 0.0);

    vec3 center_delta = light_center - ray_origin;
    float closest_t = dot(center_delta, ray_direction);
    vec3 closest_point = ray_origin + ray_direction * max(closest_t, 0.0);
    float radial_distance = length(light_center - closest_point);

    vec3 result = vec3(0.0);

    // Smooth volumetric halo computed in angular space so apparent glow
    // remains constant regardless of how far the camera is from the light.
    if (closest_t > 0.0 && closest_t < scene_hit_distance)
    {
        // Angular radial: angle in radians from ray axis to light center.
        float inv_dist = 1.0 / max(closest_t, 0.001);
        float angular_radial  = radial_distance * inv_dist;
        float angular_source  = source_radius   * inv_dist;

        // Perspective-responsive halo spread: apparent size shrinks as
        // camera distance increases, while halo_intensity controls glow energy.
        float halo_sigma_outer_ang = max(angular_source * 4.2 * halo_radius, 0.00015);
        float halo_sigma_inner_ang = max(angular_source * 1.6 * halo_radius, 0.00008);

        float halo_outer = exp(-(angular_radial * angular_radial) / max(halo_sigma_outer_ang * halo_sigma_outer_ang, 1e-6));
        float halo_inner = exp(-(angular_radial * angular_radial) / max(halo_sigma_inner_ang * halo_sigma_inner_ang, 1e-6));

        // Keep emitter halo stable with camera zoom: no camera-distance fade.
        float halo_hotness = clamp(halo_inner * 0.75 + halo_outer * 0.25, 0.0, 1.0);
        vec3 halo_color = mix(base_color * 0.55, vec3(1.0, 0.985, 0.955), halo_hotness * 0.55);
        float halo_energy = (halo_outer * 0.55 + halo_inner * 0.45);
        result += halo_color * intensity * halo_intensity * halo_energy * 1.1;
    }

    // Analytic emitter sphere intersection so the source exists in real 3D space.
    vec3 oc = ray_origin - light_center;
    float b = dot(oc, ray_direction);
    float c = dot(oc, oc) - source_radius * source_radius;
    float h = b * b - c;
    if (h >= 0.0)
    {
        float s = sqrt(h);
        float t_near = -b - s;
        float t_far = -b + s;
        float hit_t = t_near > 0.0 ? t_near : (t_far > 0.0 ? t_far : -1.0);
        if (hit_t > 0.0 && hit_t < scene_hit_distance)
        {
            vec3 hit_position = ray_origin + ray_direction * hit_t;
            vec3 sphere_normal = normalize(hit_position - light_center);
            float facing = clamp(dot(-ray_direction, sphere_normal), 0.0, 1.0);
            float radial_unit = clamp(radial_distance / max(source_radius, 1e-6), 0.0, 1.0);
            float radial_center = 1.0 - radial_unit;

            // Broad center lobe plus a smaller hot core to avoid a tiny white pin-dot.
            float body_weight = pow(radial_center, 1.8);
            float core_weight = pow(radial_center, 3.2);
            float limb = 0.5 + 0.5 * facing;

            float whiten = clamp(body_weight * 0.55 + core_weight * 0.45, 0.0, 1.0);
            vec3 warm_white = vec3(1.0, 0.992, 0.97);
            vec3 radial_color = mix(base_color, warm_white, whiten);

            float brightness = (1.2 + 4.5 * body_weight + 7.5 * core_weight) * limb;
            result += radial_color * intensity * brightness;
        }
    }

    return result;
}

// Optional volumetric spotlight shaft ("flashlight in fog"). The camera ray is
// marched through the spot cone and in-scattered light is accumulated so the
// beam becomes visible in the air, not just where it lands on geometry. This is
// the GLSL realization of the projection-volume technique: at each sample we
// test whether the point lies inside the cone (same inner/outer smoothstep the
// surface shading uses), apply distance falloff and a Henyey-Greenstein phase
// term so the beam glows brightest when the camera looks down it, then integrate
// over the marched segment.
//
// Gated entirely on spot_light_data.z (the volumetric strength packed by
// Lighting.cpp). When the editor checkbox is off that value is 0 and this
// function returns immediately, so there is zero cost for ordinary spotlights.
vec3 evaluate_spot_light_volume(vec3 ray_origin, vec3 ray_direction, float scene_hit_distance)
{
    float volumetric_strength = scene_uniforms.spot_light_data.z;
    if (volumetric_strength <= 0.0 || scene_uniforms.spot_light_color.a <= 0.0)
    {
        return vec3(0.0);
    }

    vec3 light_pos = scene_uniforms.spot_light_position.xyz;
    vec3 light_forward = normalize(scene_uniforms.spot_light_direction.xyz);
    float cos_inner = scene_uniforms.spot_light_direction.w;
    float cos_outer = scene_uniforms.spot_light_data.x;
    float range = max(scene_uniforms.spot_light_position.w, 0.0001);

    // Only march the part of the ray that could possibly intersect the lit
    // sphere of influence: from the camera up to min(geometry hit, the far edge
    // of the light's reach along this ray). Samples outside the cone or beyond
    // the range are rejected analytically, so this bound just caps the loop.
    float t_near = 0.0;
    float t_far = min(scene_hit_distance, distance(ray_origin, light_pos) + range);
    if (t_far <= t_near)
    {
        return vec3(0.0);
    }

    const int kSteps = 48;
    float segment = t_far - t_near;
    float step_size = segment / float(kSteps);

    // Dither the march start per pixel and per frame so the fixed step count
    // does not produce visible banding; TAA averages the jitter away.
    uint dither_seed = (gl_LaunchIDEXT.x * 1973u + gl_LaunchIDEXT.y * 9277u)
        ^ (scene_uniforms.accumulation_data.w * 26699u + 1u);
    float jitter = hash_to_unit_float(dither_seed);

    // Henyey-Greenstein forward-scattering phase. cos_scatter is the angle
    // between the light's travel direction at the sample and the direction back
    // to the camera (-ray_direction); g > 0 biases the glow toward looking into
    // the beam.
    const float g = 0.55;
    const float g_sq = g * g;

    float accum = 0.0;
    for (int i = 0; i < kSteps; ++i)
    {
        float t = t_near + (float(i) + jitter) * step_size;
        vec3 sample_pos = ray_origin + ray_direction * t;
        vec3 to_sample = sample_pos - light_pos;
        float dist = length(to_sample);
        if (dist > range || dist < 1e-4)
        {
            continue;
        }

        vec3 light_to_sample = to_sample / dist;
        float cone_cos = dot(light_forward, light_to_sample);
        float cone_factor = smoothstep(cos_outer, cos_inner, cone_cos);
        if (cone_factor <= 0.0)
        {
            continue;
        }

        // Match the surface shading falloff: (1 - d/range)^2.
        float range_factor = clamp(1.0 - dist / range, 0.0, 1.0);
        range_factor *= range_factor;

        // Shadow the sample against the light so geometry standing in the beam
        // blocks the shaft behind it instead of the cone shining straight
        // through models. Trace from the sample back toward the light; a hit
        // before reaching the source drives shadow_payload to 0 (occluded).
        // light_to_sample points from the light to the sample, so the ray
        // toward the light is -light_to_sample.
        shadow_payload = 1.0;
        traceRayEXT(
            top_level_as,
            gl_RayFlagsNoneEXT,
            0xFF,
            1,
            1,
            1,
            sample_pos,
            0.001,
            -light_to_sample,
            max(dist - 0.01, 0.001),
            1);
        if (shadow_payload <= 0.0)
        {
            continue;
        }

        float cos_scatter = dot(light_to_sample, -ray_direction);
        float phase_denom = pow(max(1.0 + g_sq - 2.0 * g * cos_scatter, 1e-4), 1.5);
        float phase = (1.0 - g_sq) / (4.0 * 3.14159265 * phase_denom);

        accum += cone_factor * range_factor * phase;
    }

    // Multiply by step length so the result is independent of the step count,
    // then by a base scattering density that keeps default intensities sane.
    const float kScatterDensity = 0.6;
    float in_scatter = accum * step_size * kScatterDensity * volumetric_strength;

    return scene_uniforms.spot_light_color.rgb * scene_uniforms.spot_light_color.a * in_scatter;
}

vec3 trace_primary_sample(vec2 pixel_sample, vec2 launch_size)
{
    vec2 ndc = (pixel_sample / launch_size) * 2.0 - 1.0;

    vec4 clip_target = vec4(ndc.x, ndc.y, 1.0, 1.0);
    vec4 view_target = scene_uniforms.projection_inverse * clip_target;
    vec3 view_direction = normalize(view_target.xyz / max(view_target.w, 0.0001));
    vec3 world_origin = (scene_uniforms.view_inverse * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    vec3 world_direction = normalize((scene_uniforms.view_inverse * vec4(view_direction, 0.0)).xyz);

    primary_payload.color = vec4(0.08, 0.09, 0.11, 1.0);
    primary_payload.hit_distance = 1e30;
    primary_payload.depth = 0;
    primary_payload.pos_ws_curr = vec3(0.0);
    primary_payload.pos_ws_prev = vec3(0.0);
    primary_payload.material_flags = 0u;
    traceRayEXT(
        top_level_as,
        gl_RayFlagsNoneEXT,
        0xFF,
        0,
        1,
        0,
        world_origin,
        0.001,
        world_direction,
        10000.0,
        0);

    vec3 shaded = primary_payload.color.rgb;
    shaded += evaluate_point_light_emitter(world_origin, world_direction, primary_payload.hit_distance);
    shaded += evaluate_spot_light_volume(world_origin, world_direction, primary_payload.hit_distance);

    if (scene_uniforms.underwater_data.x > 0.5)
    {
        vec3 camera_local = (scene_uniforms.underwater_world_to_local * vec4(world_origin, 1.0)).xyz;
        bool inside_water_footprint =
            abs(camera_local.x) <= WATER_PLANE_HALF_EXTENT &&
            abs(camera_local.z) <= WATER_PLANE_HALF_EXTENT;
        float time_seconds = scene_uniforms.animation_time_data.x;
        float water_surface_local_y = water_wave_height(camera_local.xz, time_seconds);
        if (inside_water_footprint && camera_local.y < water_surface_local_y)
        {
            // Thickness = actual ray-traced path length through water (same fix as surface shader).
            // Camera is inside the water volume so the entire path to geometry is through water.
            float thickness = primary_payload.hit_distance < 1e29 ? primary_payload.hit_distance : 5.0;

            // Normalise thickness to [0,1] over max_depth before Beer-Lambert.
            // Raw world-unit absorption over-attenuates because the ray travels obliquely.
            const float max_depth  = 10.0;
            float depth_ratio      = clamp(thickness / max_depth, 0.0, 1.0);
            vec3 transmittance     = exp(-depth_ratio * vec3(1.5, 0.3, 0.1));

            // base_tint is vec3(1.0): at thickness=0 geometry is completely unmodified (truly clear).
            // Only deep_color adds tint as depth grows; max_depth=5 suits cliff/pool scenarios.
            vec3 deep_color        = vec3(0.0,   0.341, 0.29);
            vec3 underwater_fog    = vec3(0.02,  0.18,  0.25);

            // Volume color: neutral at surface, deep_color-tinted when deep
            vec3 water_volume_color    = mix(vec3(1.0), deep_color, depth_ratio);
            vec3 apparent_seabed_color = shaded * water_volume_color;

            // Primary blend: clear geometry when shallow, fog dominates when deep
            shaded = mix(underwater_fog, apparent_seabed_color, transmittance);

            // Secondary fog falloff, normalised so it doesn't darken shallow water
            float deep_fog = 1.0 - exp(-depth_ratio * 2.45);
            shaded = mix(shaded, underwater_fog, deep_fog * 0.85);
        }
    }

    return shaded;
}

void main()
{
    vec2 launch_size = vec2(gl_LaunchSizeEXT.xy);
    vec2 pixel_base = vec2(gl_LaunchIDEXT.xy) + vec2(0.5);
    ivec2 ipos = ivec2(gl_LaunchIDEXT.xy);

    // Sub-pixel jitter (sourced from the host so the matrices and the jitter
    // stay in lock-step). When TAA is off the host writes (0, 0) here.
    vec2 jitter = scene_uniforms.jitter_offset.xy;

    // ---- Sample 0: canonical pre-jitter ray (drives motion vector) --------
    // This is also the ray whose payload tells us whether the pixel hit a
    // material tagged for supersampling (currently any material whose
    // authored name starts with "Hair"). Selective supersampling is gated
    // entirely on that flag; the previous frame's luma-contrast probe was
    // dropped because it fired on every high-contrast pixel (specular
    // highlights, alpha edges, foliage) which is far more pixels than the
    // hair-only budget we want.
    vec2 pixel_sample = pixel_base + jitter;
    vec3 accum = trace_primary_sample(pixel_sample, launch_size);

    int sample_count = 1;
    if (scene_uniforms.adaptive_params.x > 0.5
        && scene_uniforms.adaptive_params.y > 1.5
        && (primary_payload.material_flags & 1u) != 0u)
    {
        sample_count = int(clamp(scene_uniforms.adaptive_params.y, 1.0, 8.0));
    }

    // Per-object motion vector (primary_rays.rgen):
    //   pos_ws_curr = triangle.positions       * bary
    //   pos_ws_prev = triangle.positions_prev  * bary
    //   projection_view_to_screen(V      * pos_ws_curr, screen_pos_curr, ..., false);
    //   projection_view_to_screen(V_prev * pos_ws_prev, screen_pos_prev, ..., true);
    //   motion.xy = screen_pos_prev - screen_pos_curr;
    // The V/P matrices are UNJITTERED -- jitter is applied only when generating
    // the ray (the host writes `sub_pixel_jitter` and the rgen launches the ray
    // through `pixel_center + jitter`). pos_ws_curr is the real 3D hit point;
    // projecting it back through unjittered V*P recovers the jittered launch
    // UV (since that's where the ray went). TAA samples history at
    //   (ipos+0.5)/size + motion = unjittered_uv + (screen_pos_prev - screen_pos_curr)
    // which is the unjittered pixel + the actual screen-space displacement of
    // the surface point between frames.
    vec2 motion = vec2(0.0);
    if (primary_payload.hit_distance < 1e29)
    {
        vec4 clip_curr = scene_uniforms.current_view_projection * vec4(primary_payload.pos_ws_curr, 1.0);
        vec4 clip_prev = scene_uniforms.prev_view_projection    * vec4(primary_payload.pos_ws_prev, 1.0);
        if (clip_curr.w > 1e-5 && clip_prev.w > 1e-5)
        {
            vec2 uv_curr = (clip_curr.xy / clip_curr.w) * 0.5 + 0.5;
            vec2 uv_prev = (clip_prev.xy / clip_prev.w) * 0.5 + 0.5;
            // Live jitter-compensation diagnostic (SettingsPanel "Jitter compensation" slider).
            //   0 = legacy motion vectors (no compensation; original behaviour, may shimmer).
            //   1 = full subtraction of the current frame's sub-pixel jitter from uv_curr.
            // Reasoning: the ray was launched through pixel_center + jitter_curr, and TAA
            // samples history at (ipos+0.5)/size + motion (i.e. the unjittered pixel center).
            // When `jitter_compensation` is 1.0 we add `-jitter_curr/size` to the motion so
            // that history is fetched at the location the surface *actually was* at the
            // pixel center, not at the jittered ray launch.
            vec2 comp = (scene_uniforms.jitter_offset.xy / launch_size) * scene_uniforms.taa_params.w;
            motion = (uv_prev - uv_curr) - comp;
        }
    }

    imageStore(motion_image, ipos, vec4(motion, 0.0, 0.0));

    // Persist this frame's primary-ray hit distance for the TAA bilateral
    // disocclusion test. Misses are written as a very large value so
    // sky->sky reprojections accept (rel diff = 0) and sky->object
    // reprojections reject (rel diff ~ 1). This is what makes the
    // helmet-pixel that was occluded by the fox last frame reject the
    // fox-colored history and converge to the helmet color in a single
    // frame rather than dragging the fox tint along for a dozen frames.
    //
    // .y carries the EXPECTED previous-frame depth of this hit: the distance
    // from last frame's camera position to the hit point's previous-frame
    // world position. The TAA pass compares this against the previous
    // frame's stored .x at the reprojected pixel, so both sides of the test
    // are distances from the SAME (previous) camera. For static geometry
    // under a translating camera the two agree exactly, and the per-object
    // pos_ws_prev makes them agree for rigid/skinned movers too; only a
    // genuine reveal (a different surface exposed this frame) produces a
    // large mismatch.
    {
        float linear_depth = 1e30;
        float expected_prev_depth = 1e30;
        if (primary_payload.hit_distance < 1e29)
        {
            linear_depth = primary_payload.hit_distance;
            expected_prev_depth = distance(primary_payload.pos_ws_prev, scene_uniforms.prev_camera_position.xyz);
        }
        imageStore(depth_image, ipos, vec4(linear_depth, expected_prev_depth, 0.0, 0.0));
    }

    // ---- Extra samples (supersampling): rotated-grid pattern within pixel.
    // Sub-offsets are deterministic per supersample index so the average is
    // stable across frames (no extra noise injected). Motion vector and
    // hit/miss decisions stay tied to sample 0, the canonical pre-jitter ray.
    //
    // Combine rule (when sample_count > 1):
    //   avg = sum(samples) / N        -- physically correct coverage average.
    //   max_c = elementwise max       -- represents "the strand sample" when
    //                                    one of N rays catches a subpixel
    //                                    feature the others miss.
    //   spread = luma(max_c - min_c)  -- large for subpixel strands /
    //                                    specular spikes, small for smooth
    //                                    surfaces.
    //   bias = smoothstep(0.3, 1.5, spread) * preservation
    //   result = mix(avg, max_c, bias)
    //
    // The preservation knob (adaptive_params.w) lets the user trade between:
    //   0.0 -> pure average. Clean and stable but hair / thin highlights
    //          look semi-transparent because the strand only covers a
    //          fraction of the pixel footprint.
    //   1.0 -> full max-bias on high-spread pixels. Hair stays at near-full
    //          opacity because whenever the strand is anywhere in the pixel
    //          footprint, at least one of N rays catches it and we keep
    //          that bright value. Can amplify HDR fireflies on specular.
    //   0.7 -> default; preserves features without obvious firefly cost.
    vec3 current_color;
    if (sample_count > 1)
    {
        vec3 min_c = accum;
        vec3 max_c = accum;
        // 8-tap rotated-grid pattern in [-0.5, +0.5] pixel space, excluding
        // the origin (which is sample 0). Indices 0..6 cover up to 7 extras.
        const vec2 kSubOffsets[7] = vec2[7](
            vec2( 0.375, -0.125),
            vec2(-0.125, -0.375),
            vec2(-0.375,  0.125),
            vec2( 0.125,  0.375),
            vec2( 0.250,  0.250),
            vec2(-0.250,  0.250),
            vec2(-0.250, -0.250));
        for (int s = 1; s < sample_count; ++s)
        {
            vec2 sub = kSubOffsets[(s - 1) % 7];
            vec3 c = trace_primary_sample(pixel_base + jitter + sub, launch_size);
            accum += c;
            min_c = min(min_c, c);
            max_c = max(max_c, c);
        }
        vec3 avg = accum / float(sample_count);
        float spread = dot(max_c - min_c, vec3(0.2126, 0.7152, 0.0722));
        float bias = smoothstep(0.3, 1.5, spread) * clamp(scene_uniforms.adaptive_params.w, 0.0, 1.0);
        current_color = mix(avg, max_c, bias);
    }
    else
    {
        current_color = accum;
    }

    imageStore(history_image, ipos, vec4(current_color, 1.0));
    imageStore(output_image, ipos, vec4(linear_to_srgb(current_color), 1.0));
}
