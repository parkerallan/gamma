#version 460
//
// SMAA 1x neighborhood blending + linear-to-sRGB resolve (stub).
//
// Phase 1a: ignores weights_image, just copies history (linear HDR rgba16f)
// to output_image (rgba8 sRGB). When the weights pass is also a stub, the
// final image is identical to no-AA, but the full 3-pass pipeline executes
// every frame so the C++ wiring is exercised.
//
// Final shader (Phase 2) will implement SMAANeighborhoodBlendingPS:
//   - Read weights at (pixel) and (pixel-1, pixel+1) to find dominant edge.
//   - Bilinearly tap history along the edge direction.
//   - Output the blended color, then linear->sRGB.
//
// Local size 8x8 matches the rest of the chain.
//
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly  image2D history_image;
layout(set = 0, binding = 1, rgba8)   uniform readonly  image2D weights_image;
layout(set = 0, binding = 2, rgba8)   uniform writeonly image2D output_image;

float linear_to_srgb_channel(float v)
{
    v = max(v, 0.0);
    if (v <= 0.0031308)
    {
        return v * 12.92;
    }
    return 1.055 * pow(v, 1.0 / 2.4) - 0.055;
}

vec3 linear_to_srgb(vec3 c)
{
    return clamp(
        vec3(linear_to_srgb_channel(c.r),
             linear_to_srgb_channel(c.g),
             linear_to_srgb_channel(c.b)),
        vec3(0.0),
        vec3(1.0));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(output_image);
    if (pixel.x >= size.x || pixel.y >= size.y)
    {
        return;
    }

    vec3 history_linear = imageLoad(history_image, pixel).rgb;

    // Touch weights so the binding is not optimized away. Stub multiplier is
    // zero so the resolved color equals the history tap.
    vec4 weight_probe = imageLoad(weights_image, pixel) * 0.0;
    vec3 resolved = history_linear + weight_probe.rgb;

    imageStore(output_image, pixel, vec4(linear_to_srgb(resolved), 1.0));
}
