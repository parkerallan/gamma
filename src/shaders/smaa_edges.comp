#version 460
//
// SMAA 1x edge detection (stub).
//
// Phase 1a placeholder: writes a zero edge mask for every pixel, which causes
// the blend-weights pass to find no edges and the neighborhood-blend pass to
// pass history through unchanged. This proves out the descriptor / pipeline /
// barrier chain without changing the on-screen image.
//
// Final shader (Phase 2) will implement SMAALumaEdgeDetectionPS from SMAA.hlsl:
//   - Sample current pixel + 4 cardinal neighbours of history_image
//   - Convert to perceptual luma
//   - Compute |L - L_left|, |L - L_top|, plus 2nd-order deltas
//   - Emit (edge_left, edge_top) as rg8 in [0, 1]
//
// Local size 8x8 matches the rest of the post-AA chain.
//
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly  image2D history_image;
layout(set = 0, binding = 1, rg8)     uniform writeonly image2D edges_image;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(edges_image);
    if (pixel.x >= size.x || pixel.y >= size.y)
    {
        return;
    }

    // Stub: no edges detected anywhere.
    imageStore(edges_image, pixel, vec4(0.0, 0.0, 0.0, 0.0));
}
