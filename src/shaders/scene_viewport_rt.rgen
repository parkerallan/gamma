#version 460
#extension GL_EXT_ray_tracing : require

struct PrimaryPayload
{
    vec4 color;
    float hit_distance;
    uint depth;
};

layout(set = 0, binding = 0) uniform accelerationStructureEXT top_level_as;
layout(set = 0, binding = 1, rgba8) uniform image2D output_image;
layout(set = 0, binding = 7, rgba16f) uniform image2D history_image;

layout(set = 0, binding = 2, std140) uniform SceneUniforms
{
    mat4 view_inverse;
    mat4 projection_inverse;
    vec4 ambient_light;
    vec4 directional_light_color;
    vec4 directional_light_direction;
    vec4 directional_light_data;
    vec4 point_light_color;
    vec4 point_light_position;
    vec4 point_light_data;
    vec4 spot_light_color;
    vec4 spot_light_direction;
    vec4 spot_light_position;
    vec4 spot_light_data;
    vec4 grid_data;
    vec4 grid_origin_extent;
    vec4 skybox_data;
    uvec4 counts;
    uvec4 accumulation_data;
} scene_uniforms;

layout(location = 0) rayPayloadEXT PrimaryPayload primary_payload;

uint pcg_hash(uint value)
{
    uint state = value * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float hash_to_unit_float(uint value)
{
    return float(pcg_hash(value)) * (1.0 / 4294967296.0);
}

vec2 jittered_sample_offset(uvec2 pixel, uint sample_index, uint frame_index)
{
    const vec2 base_offsets[4] = vec2[4](
        vec2(0.125, 0.375),
        vec2(0.625, 0.125),
        vec2(0.375, 0.875),
        vec2(0.875, 0.625));

    uint seed = pixel.x * 73856093u ^ pixel.y * 19349663u ^ sample_index * 83492791u ^ frame_index * 2654435761u;
    vec2 jitter = vec2(
        hash_to_unit_float(seed),
        hash_to_unit_float(seed ^ 0x9e3779b9u));
    return base_offsets[sample_index] + jitter * 0.0625;
}

float linear_to_srgb_channel(float value)
{
    value = max(value, 0.0);
    if (value <= 0.0031308)
    {
        return value * 12.92;
    }

    return 1.055 * pow(value, 1.0 / 2.4) - 0.055;
}

vec3 linear_to_srgb(vec3 value)
{
    return clamp(
        vec3(
            linear_to_srgb_channel(value.r),
            linear_to_srgb_channel(value.g),
            linear_to_srgb_channel(value.b)),
        vec3(0.0),
        vec3(1.0));
}

vec3 evaluate_point_light_emitter(vec3 ray_origin, vec3 ray_direction, float scene_hit_distance)
{
    if (scene_uniforms.point_light_color.a <= 0.0)
    {
        return vec3(0.0);
    }

    vec3 light_center = scene_uniforms.point_light_position.xyz;
    float source_radius = max(scene_uniforms.point_light_data.x, 0.02);
    float halo_intensity = max(scene_uniforms.point_light_data.y, 0.0);
    float halo_radius    = max(scene_uniforms.point_light_data.z, 0.01);
    float light_range = max(scene_uniforms.point_light_position.w, 0.001);
    vec3 base_color = max(scene_uniforms.point_light_color.rgb, vec3(0.0));
    float intensity = max(scene_uniforms.point_light_color.a, 0.0);

    vec3 center_delta = light_center - ray_origin;
    float closest_t = dot(center_delta, ray_direction);
    vec3 closest_point = ray_origin + ray_direction * max(closest_t, 0.0);
    float radial_distance = length(light_center - closest_point);

    vec3 result = vec3(0.0);

    // Smooth volumetric halo computed in angular space so apparent glow
    // remains constant regardless of how far the camera is from the light.
    if (closest_t > 0.0 && closest_t < scene_hit_distance)
    {
        // Angular radial: angle in radians from ray axis to light center.
        float inv_dist = 1.0 / max(closest_t, 0.001);
        float angular_radial  = radial_distance * inv_dist;
        float angular_source  = source_radius   * inv_dist;

        // Perspective-responsive halo spread: apparent size shrinks as
        // camera distance increases, while halo_intensity controls glow energy.
        float halo_sigma_outer_ang = max(angular_source * 4.2 * halo_radius, 0.00015);
        float halo_sigma_inner_ang = max(angular_source * 1.6 * halo_radius, 0.00008);

        float halo_outer = exp(-(angular_radial * angular_radial) / max(halo_sigma_outer_ang * halo_sigma_outer_ang, 1e-6));
        float halo_inner = exp(-(angular_radial * angular_radial) / max(halo_sigma_inner_ang * halo_sigma_inner_ang, 1e-6));

        // Keep emitter halo stable with camera zoom: no camera-distance fade.
        float halo_hotness = clamp(halo_inner * 0.75 + halo_outer * 0.25, 0.0, 1.0);
        vec3 halo_color = mix(base_color * 0.55, vec3(1.0, 0.985, 0.955), halo_hotness * 0.55);
        float halo_energy = (halo_outer * 0.55 + halo_inner * 0.45);
        result += halo_color * intensity * halo_intensity * halo_energy * 1.1;
    }

    // Analytic emitter sphere intersection so the source exists in real 3D space.
    vec3 oc = ray_origin - light_center;
    float b = dot(oc, ray_direction);
    float c = dot(oc, oc) - source_radius * source_radius;
    float h = b * b - c;
    if (h >= 0.0)
    {
        float s = sqrt(h);
        float t_near = -b - s;
        float t_far = -b + s;
        float hit_t = t_near > 0.0 ? t_near : (t_far > 0.0 ? t_far : -1.0);
        if (hit_t > 0.0 && hit_t < scene_hit_distance)
        {
            vec3 hit_position = ray_origin + ray_direction * hit_t;
            vec3 sphere_normal = normalize(hit_position - light_center);
            float facing = clamp(dot(-ray_direction, sphere_normal), 0.0, 1.0);
            float radial_unit = clamp(radial_distance / max(source_radius, 1e-6), 0.0, 1.0);
            float radial_center = 1.0 - radial_unit;

            // Broad center lobe plus a smaller hot core to avoid a tiny white pin-dot.
            float body_weight = pow(radial_center, 1.8);
            float core_weight = pow(radial_center, 3.2);
            float limb = 0.5 + 0.5 * facing;

            float whiten = clamp(body_weight * 0.55 + core_weight * 0.45, 0.0, 1.0);
            vec3 warm_white = vec3(1.0, 0.992, 0.97);
            vec3 radial_color = mix(base_color, warm_white, whiten);

            float brightness = (1.2 + 4.5 * body_weight + 7.5 * core_weight) * limb;
            result += radial_color * intensity * brightness;
        }
    }

    return result;
}

vec3 trace_primary_sample(vec2 pixel_sample, vec2 launch_size)
{
    vec2 ndc = (pixel_sample / launch_size) * 2.0 - 1.0;

    vec4 clip_target = vec4(ndc.x, ndc.y, 1.0, 1.0);
    vec4 view_target = scene_uniforms.projection_inverse * clip_target;
    vec3 view_direction = normalize(view_target.xyz / max(view_target.w, 0.0001));
    vec3 world_origin = (scene_uniforms.view_inverse * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    vec3 world_direction = normalize((scene_uniforms.view_inverse * vec4(view_direction, 0.0)).xyz);

    primary_payload.color = vec4(0.08, 0.09, 0.11, 1.0);
    primary_payload.hit_distance = 1e30;
    primary_payload.depth = 0;
    traceRayEXT(
        top_level_as,
        gl_RayFlagsNoneEXT,
        0xFF,
        0,
        1,
        0,
        world_origin,
        0.001,
        world_direction,
        10000.0,
        0);

    vec3 shaded = primary_payload.color.rgb;
    shaded += evaluate_point_light_emitter(world_origin, world_direction, primary_payload.hit_distance);
    return shaded;
}

void main()
{
    vec2 launch_size = vec2(gl_LaunchSizeEXT.xy);
    vec2 pixel_base = vec2(gl_LaunchIDEXT.xy);
    uint frame_index = scene_uniforms.accumulation_data.x;
    uint history_sample_count = scene_uniforms.accumulation_data.y != 0u ? scene_uniforms.accumulation_data.x : 0u;

    vec3 current_color = vec3(0.0);
    for (uint sample_index = 0u; sample_index < 4u; ++sample_index)
    {
        current_color += trace_primary_sample(pixel_base + jittered_sample_offset(gl_LaunchIDEXT.xy, sample_index, frame_index), launch_size);
    }

    current_color *= 0.25;

    vec3 accumulated_linear = current_color;
    if (history_sample_count > 0u)
    {
        vec3 history_color = imageLoad(history_image, ivec2(gl_LaunchIDEXT.xy)).rgb;
        float blend = 1.0 / float(history_sample_count + 1u);
        accumulated_linear = mix(history_color, current_color, blend);
    }

    imageStore(history_image, ivec2(gl_LaunchIDEXT.xy), vec4(accumulated_linear, 1.0));
    imageStore(output_image, ivec2(gl_LaunchIDEXT.xy), vec4(linear_to_srgb(accumulated_linear), 1.0));
}
