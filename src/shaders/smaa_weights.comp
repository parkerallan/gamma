#version 460
//
// SMAA 1x blend-weight calculation (stub).
//
// Phase 1a placeholder: writes zero blend weights for every pixel. With the
// neighborhood-blend pass interpreting zero weights as "do not blend," the
// final image equals history_image (modulo linear->sRGB).
//
// Final shader (Phase 2) will implement SMAABlendingWeightCalculationPS:
//   - For each pixel marked as edge in edges_image, search L/R or U/D until
//     the edge ends (using SearchTex as a precomputed search-step LUT).
//   - Sample AreaTex at (left_dist, right_dist, crossing_pattern) to get
//     analytic edge coverage.
//   - Emit per-side coverage in rgba8 (top, right, bottom, left).
//
// The AreaTex/SearchTex LUT bindings are intentionally NOT declared in this
// Phase 1a stub: declaring sampler2D bindings without uploading actual LUT
// data would trigger validation errors for uninitialized combined-image-
// samplers. Phase 1b will add the LUT bindings together with their image
// uploads in lockstep. The C++ descriptor set layout in RayTracing.cpp must
// be kept in sync with this shader (currently 2 storage-image bindings only).
//
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rg8)   uniform readonly  image2D edges_image;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D weights_image;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(weights_image);
    if (pixel.x >= size.x || pixel.y >= size.y)
    {
        return;
    }

    // Acknowledge edges_image as a real read so the binding cannot be stripped.
    vec4 edge_probe = vec4(imageLoad(edges_image, pixel).rg, 0.0, 0.0) * 0.0;

    // Stub: no blend weight on any side.
    imageStore(weights_image, pixel, vec4(0.0) + edge_probe);
}
